// Guarda la contraseña de la conexión "futbol" en DfConnId.ini cifrada con la clave
// del workspace (LoginEncryptionKey.inc), que es la que leen los programas.
// La contraseña llega en la variable de entorno FUTBOL_PWD.
Use Windows.pkg
Use cConnection.pkg

Direct_Output channel 9 "GuardarPassword.txt"

Object oLogErr is a cObject
    Procedure Error_Report Integer iErrNum Integer iErrLine String sErrText
        Writeln channel 9 ("ERROR " + String(iErrNum) + ": " + sErrText)
    End_Procedure
End_Object
Move oLogErr to Error_Object_Id

Object oApplication is a cApplication
    Object oConnection is a cConnection
        Set pbAutoConnect to False
        Use LoginEncryption.pkg
    End_Object
End_Object

Procedure Main
    String sPwd
    Boolean bOk
    Integer iErr

    Get_Environment "FUTBOL_PWD" to sPwd
    If (sPwd = "") Begin
        Writeln channel 9 "ERROR: no se ha recibido la contraseña"
        Procedure_Return
    End

    Send RegisterAllConnections of ghoConnection
    Get StoreConnectionIdCredentials of ghoConnection "futbol" "root" sPwd False to bOk
    Writeln channel 9 ("Guardada: " + If(bOk, "si", "no"))

    // Recargar y probar el login con lo guardado
    Send UnRegisterAllConnections of ghoConnection
    Send RegisterAllConnections of ghoConnection
    Get LoginConnectionId of ghoConnection "futbol" to iErr
    Writeln channel 9 ("Login: " + If(iErr = 0, "OK", "fallo " + String(iErr)))
End_Procedure

Send Main
Close_Output channel 9
