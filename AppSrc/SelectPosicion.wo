Use cWebView.pkg
Use cWebPanel.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cWebColumnButton.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebLabel.pkg

Use cPosicionDataDictionary.dd

Register_Object oZoomPosicion

Object oSelectPosicion is a cWebView
    Set piColumnCount to 7
    Set psCaption to "Posiciones"
    Set pbShowCaption to False
    Set peViewType to vtSelect
    Set piMaxWidth to 1024
    Set psStateViewName to "Posiciones"

    WebSetResponsive piColumnCount rmTabletPortrait to 3

    Object oPosicion_DD is a cPosicionDataDictionary
    End_Object

    Set Main_DD to oPosicion_DD
    Set Server  to oPosicion_DD

    // Solo se ve al llegar desde un jugador (navegación nfUndefined)
    Object oHeader is a cWebLabel
        Set piColumnSpan to 0
        Set psCSSClass to "LabelDetail"
        Set pbRender to False
    End_Object

    Object oList is a cWebList
        Set piColumnSpan to 0
        Set pbFillHeight to True
        Set psCSSClass to "MobileList"
        Set piSortColumn to 0
        Set pbServerOnRowClick to True
        Set pbShowHeader to False
        Set peDbGridType to gtAllData

        Object oPosicionNombre is a cWebColumn
            Entry_Item Posicion.Nombre
            Set psCaption to "Nombre"
            Set psCSSClass to "RowCaption"
            Set piWidth to 60
        End_Object

        Object oDetailButton is a cWebColumnButton
            Set piWidth to 50
            Set pbFixedWidth to True
            Set psCaption to "btn"
            Set pbResizable to False
            Set piListRowSpan to 1
            Set psBtnCssClass to "WebButtonIcon WebIcon_Info"
            Set peAlign to alignRight

            WebRegisterPath ntNavigateForward oZoomPosicion

            Procedure OnClick String sButton String sRowId
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bReadOnly
            End_Procedure
        End_Object

        WebRegisterPath ntNavigateForward oZoomPosicion

        Procedure OnRowClick String sRowID
            tWebNavigateData NavigateData
            Get GetNavigateData to NavigateData

            Case Begin
                Case (NavigateData.eNavigateType=nfFromChild)
                Case (NavigateData.eNavigateType=nfFromMain)
                    // se ha abierto para elegir un registro: lo devolvemos
                    Send NavigateClose Self
                    Case Break
                Case Else
                    Send NavigatePath
            Case End
        End_Procedure
    End_Object

    Object oActionGroup is a cWebMenuGroup

        Object oSearch is a cWebMenuItem
            Set psCaption to "Buscar"
            Set psCSSClass to "WebPromptMenuItem"

            Procedure OnClick
                Send Search of oList
            End_Procedure
        End_Object

        Object oNewButton is a cWebMenuItem
            Set psCaption to "Nuevo"
            Set psCSSClass to "WebClearMenuItem"

            WebRegisterPath ntNavigateForward oZoomPosicion Self "NuevoPosicion"

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bNewRecord
            End_Procedure
        End_Object

    End_Object

    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
        // al elegir un padre desde una ficha no tiene sentido crear ni ver detalles
        Boolean bLookup
        String sJugador
        Move (NavigateData.eNavigateType = nfFromChild or NavigateData.eNavigateType = nfFromMain) to bLookup
        WebSet pbRender of oNewButton to (not(bLookup))
        WebSet pbRender of oDetailButton to (not(bLookup))

        // Undefined: no hay relación entre la vista que llama y ésta, así que
        // la lista no se filtra. Sólo sabemos lo que nos pasen en NamedValues.
        Get NamedValueGet NavigateData.NamedValues "jugador" to sJugador
        If (NavigateData.eNavigateType = nfUndefined and sJugador <> "") Begin
            WebSet psCaption of oHeader to ("Posiciones (abierto desde " + sJugador + ")")
            WebSet pbRender of oHeader to True
        End
        Else Begin
            WebSet pbRender of oHeader to False
        End
    End_Procedure

End_Object