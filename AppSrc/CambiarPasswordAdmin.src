// Pone una contraseña nueva al usuario "admin" de la WebApp, cifrada igual que
// cWebSessionManagerStandard ("V1$" + hash PBKDF2). La contraseña llega en la
// variable de entorno ADMIN_PWD.
Use Windows.pkg
Use cConnection.pkg
Use cPasswordHasher.pkg

Direct_Output channel 9 "CambiarPasswordAdmin.txt"

Object oLogErr is a cObject
    Procedure Error_Report Integer iErrNum Integer iErrLine String sErrText
        Writeln channel 9 ("ERROR " + String(iErrNum) + ": " + sErrText)
    End_Procedure
End_Object
Move oLogErr to Error_Object_Id

Object oApplication is a cApplication
    Object oConnection is a cConnection
        Use LoginEncryption.pkg
    End_Object
End_Object

Open WebAppUser

Object oHasher is a cPasswordHasher
End_Object

Procedure Main
    String sPwd sHash
    Boolean bOk

    Get_Environment "ADMIN_PWD" to sPwd
    If (sPwd = "") Begin
        Writeln channel 9 "ERROR: no se ha recibido la contraseña"
        Procedure_Return
    End

    Get CreatePasswordHash of oHasher sPwd (&sHash) to bOk
    If (not(bOk)) Begin
        Writeln channel 9 "ERROR: no se pudo cifrar la contraseña"
        Procedure_Return
    End

    Clear WebAppUser
    Move "admin" to WebAppUser.LoginName
    Find Eq WebAppUser by Index.1
    If (not(Found)) Begin
        Writeln channel 9 "ERROR: no existe el usuario admin"
        Procedure_Return
    End

    Reread WebAppUser
        Move ("V1$" + sHash) to WebAppUser.Password
        SaveRecord WebAppUser
    Unlock
    Writeln channel 9 "Contraseña de admin cambiada"
End_Procedure

Send Main
Close_Output channel 9
