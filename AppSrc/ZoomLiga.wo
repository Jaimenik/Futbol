Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebButton.pkg

Use cLigaDataDictionary.dd

Register_Object oSelectEquipo

Object oZoomLiga is a cWebView
    Set psCaption to "Liga"
    Set pbShowCaption to False
    Set piMaxWidth to 1024
    Set peViewType to vtZoom
    Set Verify_Save_msg to 0
    Set psStateViewName to "Liga"

    Object oLiga_DD is a cLigaDataDictionary
    End_Object

    Set Main_DD to oLiga_DD
    Set Server  to oLiga_DD

    Object oWebMainPanel is a cWebPanel
        WebSetResponsive piColumnCount rmMobile to 6
        Set piColumnCount to 12

        Object oLigaNombre is a cWebForm
            Entry_Item Liga.Nombre
            Set piColumnSpan to 8
            Set psLabel to "Nombre"
            Set peLabelPosition to lpTop
        End_Object

        Object oLigaPais is a cWebForm
            Entry_Item Liga.Pais
            Set piColumnSpan to 4
            Set psLabel to "País"
            Set peLabelPosition to lpTop
        End_Object

        Object oLigaEquipos is a cWebForm
            Entry_Item Liga.Equipos
            Set piColumnSpan to 4
            Set psLabel to "Nº de equipos"
            Set peLabelPosition to lpTop
        End_Object

        Object oLigaEquiposMax is a cWebForm
            Entry_Item Liga.EquiposMax
            Set piColumnSpan to 4
            Set psLabel to "Máximo de equipos"
            Set peLabelPosition to lpTop
        End_Object

        // From parent: Liga es padre de Equipo, así que DataFlex trata esta
        // navegación como nfFromParent y la Select de equipos sale filtrada
        // por la liga que estamos viendo.
        Object oVerEquiposBtn is a cWebButton
            Set piColumnSpan to 4
            Set psCaption to "Ver equipos de esta liga"

            WebRegisterPath ntNavigateForward oSelectEquipo

            Procedure OnClick
                Send NavigatePath
            End_Procedure
        End_Object

    End_Object

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord
        Get GetNavigateData to NavigateData
        Get HasRecord of oLiga_DD to bHasRecord

        WebSet pbRender of oEditBtn to NavigateData.bReadOnly
        WebSet pbRender of oSaveBtn to (not(NavigateData.bReadOnly))
        WebSet pbRender of oDeleteBtn to bHasRecord
        // una liga nueva sin guardar todavía no tiene equipos
        WebSet pbRender of oVerEquiposBtn to bHasRecord
    End_Procedure

    Object oActionGroup is a cWebMenuGroup

        Object oSaveBtn is a cWebMenuItem
            Set psCaption to "Guardar"
            Set psCSSClass to "WebSaveMenuItem"

            Procedure OnClick
                Send Request_Save
            End_Procedure
        End_Object

        Object oEditBtn is a cWebMenuItem
            Set psCaption to "Editar"
            Set psCSSClass to "WebEditMenuItem"

            Procedure OnClick
                Send ChangeEditMode True
                WebSet pbRender of oEditBtn to False
                WebSet pbRender of oSaveBtn to True
            End_Procedure
        End_Object

        Object oDeleteBtn is a cWebMenuItem
            Set psCaption to "Eliminar"
            Set psCSSClass to "WebDeleteMenuItem"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure
        End_Object

    End_Object

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        Send NavigateClose Self
    End_Procedure

    Procedure OnViewDeleted Handle hoServer
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
        If (HasRecord(oLiga_DD)) Begin
            Send SetBreadcrumbCaption (Trim(Liga.Nombre))
        End
        Else Begin
            Send SetBreadcrumbCaption "Nueva liga"
        End
        Send SetActionButtons
    End_Procedure

End_Object