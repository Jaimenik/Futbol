Use cWebView.pkg
Use cWebPanel.pkg
Use cWebGroup.pkg
Use cWebHtmlBox.pkg

Open Liga
Open Equipo
Open Entrenador
Open Jugador
Open Posicion

Object oDashboard is a cWebView

    // El Dashboard no tiene Server ni estructura de DDOs: así no condiciona las
    // restricciones de las vistas a las que navegamos (drilldown). Sólo lee las
    // tablas para poner el número de registros en cada tarjeta.

    Set piMaxWidth to 1024

    Set psCaption to "Inicio"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"

    // Cuenta los registros de una tabla (son tablas pequeñas)
    Function ContarRegistros Integer iFile Returns Integer
        Integer iCount
        Clear iFile
        Vfind iFile 1 GT
        While (Found)
            Increment iCount
            Vfind iFile 1 GT
        Loop
        Function_Return iCount
    End_Function

    // HTML de una tarjeta: icono, título y subtítulo. Si bClick, la tarjeta
    // lanza el OnClick del servidor al pulsarla.
    Function TileHtml String sIcon String sTitle String sSubtitle Boolean bClick Returns String
        String sClick
        If bClick Move ' data-ServerOnClick="openview"' to sClick
        Function_Return ('<div class="WebCon_Sizer"' + sClick + '>' + ;
                         '<div class="Tile_Icon">' + sIcon + '</div>' + ;
                         '<div class="Tile_Title">' + sTitle + '</div>' + ;
                         '<div class="Tile_Subtitle">' + htmlEncode(sSubtitle) + '</div>' + ;
                         '</div>')
    End_Function

    Function Recuento Integer iFile String sSingular String sPlural Returns String
        Integer iCount
        Get ContarRegistros iFile to iCount
        Function_Return (String(iCount) * If(iCount = 1, sSingular, sPlural))
    End_Function

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 24

        WebSetResponsive piColumnCount rmMobile to 1
        WebSetResponsive piColumnCount rmTabletPortrait to 16

        Object oTiles_grp is a cWebGroup
            Set piColumnSpan to 8
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 12

            Set psCSSClass to "TilesGroup"

            Object oWelcomeTile is a cWebHtmlBox
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Light"
            End_Object

            Object oLigasTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set piColumnIndex to 6
                Set psCSSClass to "Tile LightAlternate"

                WebRegisterPath ntNavigateForward oSelectLiga

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oEquiposTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Dark"

                WebRegisterPath ntNavigateForward oSelectEquipo

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oEntrenadoresTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set piColumnIndex to 6
                Set psCSSClass to "Tile DarkAlternate"

                WebRegisterPath ntNavigateForward oSelectEntrenador

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oJugadoresTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Light"

                WebRegisterPath ntNavigateForward oSelectJugador

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oPosicionesTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set piColumnIndex to 6
                Set psCSSClass to "Tile LightAlternate"

                WebRegisterPath ntNavigateForward oSelectPosicion

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object
        End_Object

    End_Object

    // Cada vez que se enseña el Dashboard (también al volver de otra vista)
    // se recalculan los recuentos, así reflejan altas y bajas recientes.
    Procedure OnBeforeShow
        Send UpdateHTML of oWelcomeTile (TileHtml(Self, "👋", "Hola", psUserName(SessionManager(Self)), False))
        Send UpdateHTML of oLigasTile (TileHtml(Self, "🏆", "Ligas", Recuento(Self, Liga.File_Number, "liga", "ligas"), True))
        Send UpdateHTML of oEquiposTile (TileHtml(Self, "🛡️", "Equipos", Recuento(Self, Equipo.File_Number, "equipo", "equipos"), True))
        Send UpdateHTML of oEntrenadoresTile (TileHtml(Self, "📋", "Entrenadores", Recuento(Self, Entrenador.File_Number, "entrenador", "entrenadores"), True))
        Send UpdateHTML of oJugadoresTile (TileHtml(Self, "👟", "Jugadores", Recuento(Self, Jugador.File_Number, "jugador", "jugadores"), True))
        Send UpdateHTML of oPosicionesTile (TileHtml(Self, "🧭", "Posiciones", Recuento(Self, Posicion.File_Number, "posición", "posiciones"), True))
    End_Procedure

End_Object
