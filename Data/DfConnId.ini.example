; Copia este archivo como DfConnId.ini y guarda la contrase?a de MySQL con
; Programs\guardar_password.ps1 (o en Studio: Database > SQL Connection Manager)
[connection1]
id=futbol
driver=ODBC_DRV
connection=DRIVER={MySQL ODBC 9.6 Unicode Driver};SERVER=localhost;PORT=3306;DATABASE=futbol;CHARSET=utf8mb4
UID=root
